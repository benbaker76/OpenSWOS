# to generate assembler listing with LTO, add to LDFLAGS: -Wa,-adhln=$@.listing,--listing-rhs-width=200
# for better annotations add -dA -dP
# to generate assembler source with LTO, add to LDFLAGS: -save-temps=cwd

ifdef OS
	WINDOWS = 1
	SHELL = cmd.exe
endif

# Data module flags: set to 1 to use C data, 0 to use ASM data
COMPETITION_DATA_C ?= 1   # worldCup, copaAmerica, cupPick*, careerContests, etc.
TACTICS_DATA_C     ?= 1   # positions*, sidePitchPositions*, tacticPosMap*, teamTactics*
FIXTURE_DATA_C     ?= 1   # fixtureSchedule2..24Teams
SIMULATION_DATA_C  ?= 1   # sim*Thresh, goalScorerDist*, quadrant*, skill*
PLAYER_DATA_C      ?= 1   # playerCardChances*, playerPositions*
RENDER_DATA_C      ?= 1   # opponentCoachFrames, ourCoachFrames
PALETTE_DATA_C     ?= 1   # frozenPalette/muddyPalette/etc.
STRINGS_DATA_C     ?= 1   # 244 aXxxx strings
GENERAL_DATA_C     ?= 1   # countriesTable, kTeamColorsTable, etc.

DATA_FLAGS = -DCOMPETITION_DATA_C=$(COMPETITION_DATA_C) -DTACTICS_DATA_C=$(TACTICS_DATA_C) -DFIXTURE_DATA_C=$(FIXTURE_DATA_C) -DSIMULATION_DATA_C=$(SIMULATION_DATA_C) -DPLAYER_DATA_C=$(PLAYER_DATA_C) -DRENDER_DATA_C=$(RENDER_DATA_C) -DPALETTE_DATA_C=$(PALETTE_DATA_C) -DSTRINGS_DATA_C=$(STRINGS_DATA_C) -DGENERAL_DATA_C=$(GENERAL_DATA_C)

# ---- Sources ----
# Scan ONLY the directories that actually hold buildable code. This used to be
# `$(filter-out data/,$(wildcard */))`, which swept every top-level directory —
# fine when the tree was Amiga-only, but since the SDL merge the root also holds
# bin/ docs/ tools/ wasm/ scripts/ build/, and a stray .c in any of them (e.g.
# tools/swos_position_value.c) would silently join the m68k link.
SRC_DIRS := src

# The build stamp, same as the SDL makefile: src/build_info.c is picked up by the
# src/*.c scan above, so the m68k binary carries the commit too.
# Invoked through `sh`, not as an executable: core.filemode is false on the
# development mount and every script here is recorded 100644, so a fresh clone
# cannot exec it -- which broke the first clean-export build of this commit.
BUILD_STAMP_UNUSED := $(shell sh scripts/gen_build_info.sh)
VPATH     = $(SRC_DIRS) support asm

# SDL-only translation units. They live in the shared src/ (see CLAUDE.md
# "one C source tree, two targets") but pull in SDL2 / hosted-libc headers the
# m68k -nostdlib toolchain has no answer for, so they are excluded by NAME here
# rather than wrapped in #ifdef SWOS_SDL_BUILD — the Amiga build shouldn't pay
# to preprocess ~14k lines it always discards.
#
# Adding a new SDL-only file? Add it here too, or the Amiga build breaks.
# Anything genuinely shared must compile for BOTH targets — that's the point of
# the merge; don't "fix" a shared file by adding it to this list.
SDL_ONLY_SRCS := \
    arcade.c              \
    assets_check.c        \
    challenge_gen.c       \
    contest_log.c         \
    audio_sdl.c           \
    crt_effects.c         \
    ini.c                 \
    input_sdl.c           \
    custom_team.c         \
    dos_sound.c           \
    dos_music.c           \
    dos_music_impl.c      \
    music_stream.c        \
    team_db.c             \
    kit_art.c             \
    uniform_menu.c        \
    match_prediction.c    \
    match_record.c        \
    match_report.c        \
    match_step.c          \
    menu_load_json.c      \
    menu_symbols.c        \
    miniz_impl.c          \
    pitch_map.c           \
    tileagent_impl.c      \
    mm_client.c           \
    netem_core.c          \
    netplay.c             \
    netplay_live_test.c   \
    netplay_lobby.c       \
    netplay_setup.c       \
    netplay_match.c       \
    netplay_ghost.c       \
    netplay_netem.c       \
    online_menus.c        \
    p2p_link.c            \
    p2p_menu.c            \
    controls_menu.c       \
    credits_menu.c        \
    platform_sdl.c        \
    platform_timer.c      \
    replay_test.c         \
    replay_v2.c           \
    rjp1.c                \
    rollback_rig.c        \
    sfx_debug.c           \
    srp_resim.c           \
    srp_writer.c          \
    state_wire.c          \
    stb_image_write_impl.c \
    swos_settings.c       \
    tactics_load_json.c

# Switch-only C++ is filtered the same way SDL_ONLY_SRCS filters C:
# platform_switch.cpp is the NN_LOG sink and includes <nn/nn_Log.h>, which the
# m68k toolchain has no idea about.
SWITCH_ONLY_SRCS := platform_switch.cpp

cpp_sources := $(filter-out $(addprefix src/,$(SWITCH_ONLY_SRCS)),$(wildcard $(addsuffix /*.cpp,$(SRC_DIRS))))
cpp_objects := $(addprefix obj/,$(patsubst %.cpp,%.o,$(notdir $(cpp_sources))))
c_sources := $(filter-out $(addprefix src/,$(SDL_ONLY_SRCS)),$(wildcard $(addsuffix /*.c,$(SRC_DIRS))))
c_objects := $(addprefix obj/,$(patsubst %.c,%.o,$(notdir $(c_sources))))
s_sources := support/gcc8_a_support.s
s_objects := $(addprefix obj/,$(patsubst %.s,%.o,$(notdir $(s_sources))))
swos_asm_sources := asm/resload_unit.s
swos_asm_objects := $(addprefix obj/,$(patsubst %.s,%.o,$(notdir $(swos_asm_sources))))
vasm_sources := $(wildcard $(addsuffix /*.asm,$(SRC_DIRS)))
vasm_objects := $(addprefix obj/, $(patsubst %.asm,%.o,$(notdir $(vasm_sources))))
objects := $(cpp_objects) $(c_objects) $(s_objects) $(swos_asm_objects) $(vasm_objects)

# Fail loudly if an SDL-only name no longer exists — otherwise the entry rots
# silently and stops excluding anything the day the file is renamed.
$(foreach f,$(SDL_ONLY_SRCS),$(if $(wildcard src/$(f)),,$(error SDL_ONLY_SRCS lists src/$(f), which does not exist — update Makefile.amiga)))
$(foreach f,$(SWITCH_ONLY_SRCS),$(if $(wildcard src/$(f)),,$(error SWITCH_ONLY_SRCS lists src/$(f), which does not exist — update Makefile.amiga)))

# https://stackoverflow.com/questions/4036191/sources-from-subdirectories-in-makefile/4038459
# http://www.microhowto.info/howto/automatically_generate_makefile_dependencies.html

# The Amiga binary links into bin/ — the SAME directory the SDL binaries and all
# the game data live in. The amiga-debug extension mounts dirname(program) as
# DH1: and its startup-sequence does `cd dh1:` before running the program, so the
# game's relative loads (data/ grafs/ grafs_aga/ sound/ save/) resolve inside
# bin/ exactly as they do for the SDL build. That is why bin/ no longer has a
# duplicate under uae/ — see CLAUDE.md "Data".
program ?= bin/SWOS2
OUT = $(program)
LDSCRIPT = SWOS2.ld
CC = m68k-amiga-elf-gcc
AS = m68k-amiga-elf-as
VASM = vasmm68k_mot

ifdef WINDOWS
	SDKDIR = $(abspath $(dir $(shell where $(CC)))..\m68k-amiga-elf\sys-include)
else
	SDKDIR = $(abspath $(dir $(shell which $(CC)))../m68k-amiga-elf/sys-include)
endif

# Optimization is parameterized so a gdb-friendly build can override it.
# DBG=1 -> -O0: precise line breakpoints (no reordering) and every local/static
# lives in memory (not elided into registers), which the gdb-driven test harness
# needs to drive the Amiga UI via input injection reliably (-Ofast reordering
# defeats it). Same struct/ABI layout as the release build, so save-format
# cross-target tests stay valid. NOTE: keep -fomit-frame-pointer even under DBG
# — -fno-omit-frame-pointer ICEs GCC 15.1.0 (dwarf2out_frame_debug_adjust_cfa);
# -g already emits CFI so gdb can still unwind without a frame pointer.
OPT = -Ofast
FP  = -fomit-frame-pointer
ifdef DBG
OPT = -O0
endif
CCFLAGS   = -g -MP -MMD -m68020 $(OPT) -nostdlib -Wextra -Wno-unused-function -Wno-volatile-register-var -Wno-stringop-overflow $(FP) -fno-tree-loop-distribution -fno-strict-aliasing -fno-exceptions -fno-optimize-sibling-calls -ffunction-sections -fdata-sections -Iinclude $(DATA_FLAGS)

# DUMP_ASM=1 → save preprocessed .i and assembly .s next to each .o.
# Slight build slowdown; output lands in obj/ alongside .o files.
DUMP_ASM ?= 1
ifeq ($(DUMP_ASM),1)
CCFLAGS   += -save-temps=obj -fverbose-asm
endif
# Escape hatch for one-off defines, e.g. make EXTRA_CFLAGS=-DPITCH_SCROLL_TEST
CCFLAGS   += $(EXTRA_CFLAGS)
CPPFLAGS  = $(CCFLAGS) -fno-rtti -fcoroutines -fno-use-cxa-atexit
ASFLAGS   = -mcpu=68020 -g --register-prefix-optional -I$(SDKDIR)
LDFLAGS   = -Wl,--emit-relocs,--no-check-sections,-e,main,-Map=$(OUT).map,-T,$(LDSCRIPT)
VASMFLAGS = -m68020 -Felf -opt-fconst -nowarn=62 -dwarf=3 -quiet -x -I. -I$(SDKDIR) $(DATA_FLAGS)

all: $(OUT)

$(OUT): $(OUT).elf
	$(info Elf2Hunk $(program))
ifdef WINDOWS
	@if not exist "$(dir $@)" mkdir "$(dir $@)"
else
	@mkdir -p "$(dir $@)"
endif
	@elf2hunk $(OUT).elf $(OUT)
#ifdef WINDOWS
#	@python $(CURDIR)/fix_hunk_relocs.py $(OUT).elf $(OUT)
#else
#	@python3 $(CURDIR)/fix_hunk_relocs.py $(OUT).elf $(OUT)
#endif

$(OUT).elf: $(objects)
	$(info Linking $(program).elf)
ifdef WINDOWS
	@if not exist out mkdir out
else
	@mkdir -p out
endif
	@$(CC) $(CCFLAGS) $(LDFLAGS) $(objects) -o $@

clean:
	$(info Cleaning...)
ifdef WINDOWS
	-@if exist obj\* del /q obj\* 2>nul
	-@if exist out\* del /q out\* 2>nul
	-@if exist "$(subst /,\,$(OUT))" del /q "$(subst /,\,$(OUT))" 2>nul
	-@if exist "$(subst /,\,$(OUT)).elf" del /q "$(subst /,\,$(OUT)).elf" 2>nul
	-@if exist "$(subst /,\,$(OUT)).map" del /q "$(subst /,\,$(OUT)).map" 2>nul
else
	@$(RM) obj/* out/* $(OUT) $(OUT).elf $(OUT).map
endif

dump-swos-c-asm:
ifdef WINDOWS
	@if not exist out mkdir out
else
	@mkdir -p out
endif
	@$(CC) $(CCFLAGS) -fverbose-asm -S -o out/SWOS.c.s $(CURDIR)/src/SWOS.c

# Emit .s assembly for every C source into obj/, using whatever flags
# the regular build would use for that translation unit. Pure inspection
# target; doesn't touch .o files or relink the binary.
c_asm_outputs := $(addprefix obj/,$(patsubst %.c,%.s,$(notdir $(c_sources))))
dump-asm: $(c_asm_outputs)
	$(info Done dumping assembly to obj/*.s)

$(c_asm_outputs) : obj/%.s : %.c
	$(info Asm-only $<)
	@$(CC) $(if $(filter obj/diy_competition.s,$@),$(CCFLAGS_O2),$(if $(filter obj/game_timers.s obj/update_players.s obj/sprite_data.s obj/menu_data.s obj/competition_data.s obj/tactics_data.s obj/fixture_data.s obj/simulation_data.s obj/player_data.s obj/render_data.s obj/palette_data.s obj/strings_data.s obj/general_data.s,$@),$(CCFLAGS_NOLTO),$(CCFLAGS))) -fverbose-asm -S -o $@ $(CURDIR)/$<

-include $(objects:.o=.d)

$(cpp_objects) : obj/%.o : %.cpp
	$(info Compiling $<)
	@$(CC) $(CPPFLAGS) -c -o $@ $(CURDIR)/$<

# game_timers.c triggers GCC ICE in LTO CCP pass — compile without LTO
CCFLAGS_NOLTO = $(subst -flto,,$(subst -fwhole-program,,$(CCFLAGS)))

# diy_competition.c has complex nested loops that -Ofast miscompiles — use -O2
CCFLAGS_O2 = $(subst -Ofast,-O2,$(CCFLAGS))

# obj/ is gitignored, so a FRESH CLONE does not have it -- and every rule below
# writes its .o (and gcc its .i on an error path) straight into it, so the first
# build of a new checkout died with "opening output file obj/<name>.o: No such
# file or directory", once per source, before anything else could go wrong. The
# tree only built here because obj/ was left over from an earlier build.
# Order-only (|) so the directory's mtime never counts as "newer" and forces a
# rebuild of everything in it. Every object is flat obj/<name>.o (the lists above
# use $(notdir ...)), so one directory is the whole story.
$(objects): | obj

# A changed flag rebuilds everything, as in the SDL Makefile (BUILD_FLAGS_STAMP there
# says why): EXTRA_CFLAGS is how build_dist.sh hands this target
# SWOS_TEST_NO_INJURIES_CARDS, and a toggled one used to relink the old objects --
# some files with the flag, some without. Not for a cmd.exe build: it has no printf.
ifndef WINDOWS
BUILD_FLAGS_STAMP := obj/.build-flags
BUILD_FLAGS_NOW   := $(strip $(CC) $(CCFLAGS) :: $(CPPFLAGS) :: $(ASFLAGS) :: $(VASMFLAGS))
ifneq ($(BUILD_FLAGS_NOW),$(strip $(shell cat $(BUILD_FLAGS_STAMP) 2>/dev/null)))
$(shell mkdir -p obj && printf '%s\n' '$(BUILD_FLAGS_NOW)' > $(BUILD_FLAGS_STAMP))
endif
$(BUILD_FLAGS_STAMP):
	@mkdir -p obj
	@printf '%s\n' '$(BUILD_FLAGS_NOW)' > $@
$(objects): $(BUILD_FLAGS_STAMP)
endif

obj:
ifdef WINDOWS
	@if not exist obj mkdir obj
else
	@mkdir -p obj
endif

$(c_objects) : obj/%.o : %.c
	$(info Compiling $<)
	@$(CC) $(if $(filter obj/diy_competition.o,$@),$(CCFLAGS_O2),$(if $(filter obj/game_timers.o obj/update_players.o obj/sprite_data.o obj/menu_data.o obj/competition_data.o obj/tactics_data.o obj/fixture_data.o obj/simulation_data.o obj/player_data.o obj/render_data.o obj/palette_data.o obj/strings_data.o obj/general_data.o,$@),$(CCFLAGS_NOLTO),$(CCFLAGS))) -c -o $@ $(CURDIR)/$<

$(s_objects): obj/%.o : %.s
	$(info Assembling $<)
	@$(AS) $(ASFLAGS) --MD $(@D)/$*.d -o $@ $(CURDIR)/$<

$(swos_asm_objects): obj/%.o : %.s
	$(info Assembling $<)
	@$(VASM) $(VASMFLAGS) -dependall=make -depfile $(@D)/$*.d -o $@ $(CURDIR)/$<

$(vasm_objects): obj/%.o : %.asm
	$(info Assembling $<)
	@$(VASM) $(VASMFLAGS) -dependall=make -depfile $(@D)/$*.d -o $@ $(CURDIR)/$<
