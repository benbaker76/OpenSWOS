*.o
*.d
*.exe
build/

# (The Emscripten/WASM outputs used to be listed here as bin/SWOS.html/.js/
# .wasm/.data. `make WASM=1` now links into dist/web — a web deployment is
# release output, not something anyone runs from bin/ — so the dist/ rule at the
# bottom of this file covers them.)

sensible-soccer-nes-c/
scripts/__pycache__/

# Arcade high-score table (runtime save next to SWOS.ini; seeded with defaults)
bin/ARCADE.HI

# generated JSON export of bin/data (regenerate: scripts/decode_data.py --dump-json)
# Use /* (not /) so git still descends into translations/ for the exceptions below.
bin/data_json/*
# ...but track ALL the translation files. en.json is regenerated from
# strings_data.c by export_translations.py, but it MUST be tracked so it ships in
# clean-checkout / bundled builds (e.g. the macOS .app copies bin/data_json
# wholesale) — otherwise every data-driven name falls back to the compiled string
# and the English translation table never loads. Regenerate + commit it when the
# English UI strings change. fr/de/it/es/nl are hand-authored translations.
!bin/data_json/translations
bin/data_json/translations/*
!bin/data_json/translations/en.json
!bin/data_json/translations/fr.json
!bin/data_json/translations/de.json
!bin/data_json/translations/it.json
!bin/data_json/translations/es.json
!bin/data_json/translations/nl.json

# bin/data_json/worlds/ (docs/WORLD_2026_27.md): the World 2026-27's data from the SWOS 96/97
# Mod (teams, packs, competitions, references). Its squads are its authors': it is NEVER
# tracked (ignored by bin/data_json/* above). Players get it as a package hosted apart
# (scripts/make_world_package.sh), which OpenSWOS Setup installs.

# Track the competition + menu JSON — these are now the SOURCE OF TRUTH for
# competition_data.c / menu_data.c, regenerated by emit_competitions.py / emit_menus.py
# (`make regen-data`, or automatically at build when the JSON changes).
!bin/data_json/competitions
bin/data_json/competitions/*
!bin/data_json/competitions/*.json
!bin/data_json/menus
bin/data_json/menus/*
!bin/data_json/menus/*.json
# Imported SWOS 2020 menus (scripts/import_swos2020_menus.py): loaded at run time,
# so they must ship like the rest.
!bin/data_json/menus/swos2020
bin/data_json/menus/swos2020/*
!bin/data_json/menus/swos2020/*.json
# OpenSWOS's own JSON-only menus (the MULTIPLAYER menu, src/p2p_menu.c): loaded at
# run time as well, so they ship too.
!bin/data_json/menus/p2p
bin/data_json/menus/p2p/*
!bin/data_json/menus/p2p/*.json
!bin/data_json/menus/openswos
bin/data_json/menus/openswos/*
!bin/data_json/menus/openswos/*.json
!bin/data_json/tactics
bin/data_json/tactics/*
!bin/data_json/tactics/*.json

# The team JSON (bin/data_json/teams/) is the original game's player database:
# not in the repo. The data setup (tools/swosdata) makes it from the player's
# own TEAM files, into the assets folder.

# Career-mode balance knobs (runtime-loaded; testers edit + relaunch, no rebuild).
!bin/data_json/career_params.json

# ---- Amiga (m68k) build outputs ----
# Objects + preprocessed/asm dumps from `make -f Makefile.amiga` (DUMP_ASM=1
# writes .i/.s next to each .o). out/ holds the dump-swos-c-asm listings.
obj/*
!obj/.gitkeep
out/*
!out/.gitkeep

# The linked Amiga binary + its ELF/map live in bin/ alongside the SDL
# binaries (FS-UAE mounts bin/ as DH1: — see Makefile.amiga `program`).
bin/SWOS2
bin/SWOS2.elf
bin/SWOS2.map
bin/OpenSWOS.slave

# FS-UAE directory-filesystem metadata sidecars + emulator state.
*.uaem
# ... except the Amiga drop's own: they carry the script flag of the Workbench launcher
!packaging/amiga/**/*.uaem
!packaging/amiga/*.uaem
uae/fs-uae/

__pycache__/

# The Cygwin runtime DLLs, copied next to bin/SWOS.exe so it runs from a
# double-click. Artifacts of the host Cygwin install, not sources — the release
# drop stages its own copies from CYGWIN_BIN (scripts/build_installer.sh).
bin/*.dll

# Built binaries + runtime log live in bin/ but are artifacts, not sources.
# (The Linux ELFs used to be tracked, inconsistently with SWOS.exe/SWOS2 which
# never were; all of them are ignored now.) Rebuild with the Makefile.
bin/SWOS
bin/SWOS.x86_64
bin/SWOS.aarch64
bin/SWOS.armhf
bin/SWOS.macos
bin/SWOS.log
# The game's log, wherever it was run from (it writes beside itself).
/SWOS.log*

# Recorded-game test corpus (docs/TESTS.md). 66 MB of binary imported from
# swos-port/tests/data. UNTRACKED until the replay rig has proven it decodes and
# replays; then decide between Git LFS and a fetch script. Restore with:
#   cp /mnt/c/Projects/GitHub/swos-port/tests/data/* tests/dos/
tests/dos/
tests/amiga/
# Converted recordings (scripts/rgd_convert.py --emit). Derived from tests/dos,
# regenerate rather than track — a full-level .swr of one recording is ~7 MB.
tests/replay/
# scripts/rollback_test.sh output: traces, logs, JSON reports.
tests/rollback/
# scripts/netplay_test.sh output: traces and logs.
tests/netplay/
# scripts/replay_v2_test.sh output: .SRP recordings, traces and logs.
tests/replay-v2/
# scripts/netplay_desync_hunt.sh output: per-round logs and any captured desync.
tests/hunt/

# Nintendo Switch target (docs/SWITCH.md). The SDK and the SDL fork are NDA and
# are never in this tree; these are just the build outputs.
obj-switch/
build-switch/
bin/SWOS.nss

# ---- release output ----
# Everything scripts/build_dist.sh, build_installer.sh, build_macos.sh and
# build_switch.sh hand to a tester: the zips, SWOS-Setup.exe, SWOS.nsp, and the
# dist/windows staging tree the Inno Setup script packages. All regenerable.
dist/

# The build stamp (scripts/gen_build_info.sh) — regenerated every build, never committed.
include/swos_build.h

# ---- one-shot investigation probes ----
# scratch/ holds the gdb-harness scripts written to answer one question each
# (scratch/README.md). They are NOT committed: what they found lives in docs/ and
# in the fixes, and the driving code is rewritten from scripts/swos_plugin.py the
# next time. The two that stayed — the career-drive recipes several docs point at
# — are tracked already, and .gitignore does not untrack a tracked file.
scratch/*.py
!scratch/copa_drive.py
!scratch/wc_drive2.py
# scripts/netplay_width_test.sh output.
tests/netplay-width/
# The golden career test (scripts/career_golden_test.sh): its careers are saves of the
# original game's data (local, like tests/dos), and its runs. The record,
# tests/career_golden.txt, is tracked.
tests/career/
tests/career-golden/

# ---- The original game's data: NOT in this repo -----------------------------
# OpenSWOS ships none of Sensible World of Soccer's own files. The data setup
# (tools/swosdata, openswos-setup / swosdata) builds them from the player's own
# copy into the assets folder ($SWOS_ASSETS, default <user SWOS folder>/assets).
# A developer may still keep them in bin/ -- the FS-UAE harness mounts bin/ as
# DH1: -- so they are ignored here, and every drop is staged from tracked files
# only (scripts/stage_runtime.sh). What stays tracked in these trees is the
# project's own: LOADER76 (the credits loader), the credits photos, the 1UP coin
# sound and the commentary README.
bin/data/*
!bin/data/credits_icons.bmp
bin/grafs/*
!bin/grafs/LOADER76.RAW
bin/grafs_aga/*
!bin/grafs_aga/LOADER76.RAW
bin/grafs_dos/
bin/grafs_jag/
bin/sound/*
!bin/sound/1UP.WAV
bin/sound_dos/*
!bin/sound_dos/commentary
bin/sound_dos/commentary/*
!bin/sound_dos/commentary/README.txt
bin/save/
# SWOS 2020's tier: five PC files and SWOS 2020's own pitches, the setup copies
# from the player's SWOS 2020 install (and makes grafs_aga/P2020_n.MAP from them).
bin/grafs_2020/

# Original-game files from the early bring-up (the disk-ID files, the reloc
# table, a memory dump of the original running) and old AGA conversions: not
# in the repo (see "The original game's data" above).
uae/artifacts/
uae/dh0/data/
data/SWOS2.REL

# Claude Code's per-machine permissions: local, never shared.
.claude/settings.local.json

# openswos.net background: drawn from the game art, copied to the server, never committed
/packaging/web/site/background.png
