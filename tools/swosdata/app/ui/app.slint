// OpenSWOS Setup: two tabs, one per version of the game -- the PC/Mac/Linux game and
// the Amiga's. Each says what to download (with the links), finds it (the Downloads
// folder is watched, a folder can be searched, a path given), and has the one button
// that makes it.
import { ListView, ProgressIndicator, Palette, CheckBox } from "std-widgets.slint";
import { Theme, TextButton, Link, Card, IconButton, PathField } from "theme.slint";

export { Theme }

export struct LinkItem {
    text: string,
    url: string,
}

// One source: its path as shown, and its state -- 0 none, 1 found, 2 not usable.
// `need-*` is the tag on each tab ("needed", "optional"), `about-*` what it gives
// there, `detail` what was found ("the 24/25 season", "disk 2 is missing").
export struct SourceRow {
    label: string,
    value: string,
    state: int,
    placeholder: string,
    need-pc: string,
    need-amiga: string,
    about-pc: string,
    about-amiga: string,
    detail: string,
    detail-warn: bool,
    links: [LinkItem],
}

// One step: `ready` when its sources are there (Install makes it), and what
// the assets folder has of it already -- 0 nothing, 1 all of it, 2 some, 3 old.
export struct PlanStep {
    name: string,
    ready: bool,
    needs: string,
    installed: int,
}

component PlanColumn inherits VerticalLayout {
    in property <[PlanStep]> steps;
    horizontal-stretch: 1;
    spacing: 4px;
    alignment: start;
    for step in root.steps: VerticalLayout {
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: step.installed == 3 ? "!" : step.ready || step.installed == 1 ? "✓" : "–";
                width: 14px;
                color: step.installed == 3 ? Theme.warn
                     : step.ready || step.installed == 1 ? Theme.ok : Theme.text-dim;
            }
            Text {
                text: step.name;
                horizontal-stretch: 1;
                color: step.ready || step.installed == 1 || step.installed == 3 ? Theme.text : Theme.text-dim;
                overflow: elide;
            }
            Text {
                text: step.installed == 3 ? (step.ready ? "update needed" : "update needed: add its source")
                    : step.ready ? (step.installed == 1 ? "ready (installed)" : "ready")
                    : step.installed == 1 ? "installed"
                    : step.installed == 2 ? "incomplete"
                    : "skipped";
                color: step.installed == 3 ? Theme.warn
                     : step.ready || step.installed == 1 ? Theme.ok
                     : step.installed == 2 ? Theme.danger : Theme.text-dim;
            }
        }
        if !step.ready && step.installed != 1 && step.installed != 3: Text {
            x: 22px;
            text: "needs " + step.needs;
            font-size: 11px;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-width: 20px;
    in property <bool> selected;
    callback clicked();
    height: 38px;
    min-width: row.preferred-width + 36px;
    border-radius: 6px;
    background: root.selected ? Theme.panel : ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.line : transparent;
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Image {
            source: root.icon;
            width: root.icon-width;
            height: 20px;
            y: (parent.height - self.height) / 2;
            // The tab not chosen is drawn quieter, its icon with it.
            opacity: root.selected ? 1.0 : 0.6;
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
        }
    }
    // The selected tab's accent along its foot.
    if root.selected: Rectangle {
        y: parent.height - 3px;
        x: 10px;
        width: parent.width - 20px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small tag: "needed" in the accent, anything else quiet.
component Tag inherits Rectangle {
    in property <string> text;
    property <bool> strong: root.text == "needed";
    height: 18px;
    width: label.preferred-width + 12px;
    border-radius: 9px;
    background: root.strong ? Theme.accent.with-alpha(0.25) : Theme.sunken.with-alpha(0.4);
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        color: root.strong ? Theme.link : Theme.text-dim;
    }
}

// One thing to get: what it is and why, where to download it, and where it was found.
component SourceLine inherits VerticalLayout {
    in property <SourceRow> item;
    in property <string> need;
    in property <string> about;
    in property <bool> enabled;
    in property <bool> can-pick;
    callback edited(string);
    callback committed(string);
    callback browse();
    callback open-url(string);
    spacing: 4px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 18px;
                height: 18px;
                source: root.item.state == 1 ? @image-url("icons/circle-check.svg")
                      : root.item.state == 2 ? @image-url("icons/alert-circle.svg")
                      : @image-url("icons/circle-dashed.svg");
                colorize: root.item.state == 1 ? Theme.ok : root.item.state == 2 ? Theme.danger : Theme.text-dim;
            }
        }
        Text {
            text: root.item.label;
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Tag { text: root.need; }
        }
        Rectangle { horizontal-stretch: 1; }
        for l in root.item.links: HorizontalLayout {
            alignment: center;
            Link {
                text: l.text + " ↗";
                url: l.url;
                vertical-alignment: center;
                open(u) => { root.open-url(u); }
            }
        }
    }
    HorizontalLayout {
        padding-left: 26px;
        Text {
            text: root.about;
            wrap: word-wrap;
            color: Theme.text-dim;
            font-size: 12px;
        }
    }
    HorizontalLayout {
        padding-left: 26px;
        spacing: 8px;
        PathField {
            horizontal-stretch: 1;
            value: root.item.value;
            placeholder: root.item.placeholder;
            invalid: root.item.state == 2;
            enabled: root.enabled;
            edited(t) => { root.edited(t); }
            committed(t) => { root.committed(t); }
        }
        IconButton {
            icon: @image-url("icons/browse.svg");
            tooltip: "Browse for " + root.item.label;
            enabled: root.enabled && root.can-pick;
            clicked => { root.browse(); }
        }
    }
    if root.item.detail != "": HorizontalLayout {
        padding-left: 26px;
        Text {
            text: root.item.detail;
            wrap: word-wrap;
            font-size: 12px;
            color: root.item.detail-warn ? Theme.warn : Theme.ok;
        }
    }
}

// An output for the Amiga: a tile to pick, with its picture.
component Choice inherits Rectangle {
    in property <image> picture;
    // Optional: the picture while it is the one chosen (the drawer, open).
    in property <image> picture-selected;
    in property <length> picture-width: 48px;
    in property <string> title;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 1;
    // Fixed: a height taken from wrapped text's preferred height is measured anew on
    // every relayout, and grew the tiles when Details was closed again.
    height: 104px;
    border-radius: 6px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : ta.has-hover ? Theme.sunken : Theme.line;
    background: root.selected ? Theme.accent.with-alpha(0.10) : Theme.field;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    body := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            width: root.picture-width;
            Image {
                source: root.selected && root.picture-selected.width > 0 ? root.picture-selected : root.picture;
                width: root.picture-width;
                image-fit: contain;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: root.text;
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.text-dim;
            }
        }
    }
}

// The log, made only while Details is open: a ListView kept in the window at 0 px tall
// works out its rows again for every line added, more than Slint allows in one update
// ("long callback/instantiation chain detected", once a line). Each line is one
// fixed-height row, so "scrolled to the bottom" is arithmetic rather than a measurement
// that lags a frame behind; it is where the log opens, and where each new line keeps it.
component LogView inherits Rectangle {
    in property <[string]> lines;
    property <length> line-height: 16px;
    property <int> count: root.lines.length;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 4px;
    min-height: 80px;
    vertical-stretch: 1;
    function to-bottom() {
        view.viewport-y = min(0px, view.visible-height - root.count * root.line-height);
    }
    changed count => { root.to-bottom(); }
    init => { root.to-bottom(); }
    view := ListView {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        for line in root.lines: Text {
            text: line;
            height: root.line-height;
            font-family: "monospace";
            font-size: 11px;
            color: Theme.text-dim;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "OpenSWOS Setup";
    icon: @image-url("../../../../packaging/linux/hicolor/256x256/apps/openswos.png");
    preferred-width: 860px;
    preferred-height: 860px;
    min-width: 720px;
    background: Theme.chrome;
    default-font-size: 13px;

    // 0 the PC/Mac/Linux game, 1 the Amiga's.
    in-out property <int> tab: 0;
    in property <[SourceRow]> sources;
    // Which rows each tab shows, in its order.
    in property <[int]> rows-pc;
    in property <[int]> rows-amiga;
    in property <string> notice;
    in property <bool> notice-error;
    in property <string> watching;
    in property <string> out-dir;
    in property <string> out-note;
    in property <[PlanStep]> plan-left;
    in property <[PlanStep]> plan-right;
    in property <bool> can-install;
    in property <bool> busy;
    in property <bool> done;
    in property <bool> outdated;
    in property <float> progress;
    in property <string> status;
    in property <bool> status-error;
    in property <[string]> log;
    in property <bool> can-play;
    in property <bool> can-pick: true;
    in property <bool> scanning;
    in property <string> scan-status;
    in-out property <bool> show-details;
    in property <string> version;
    in-out property <bool> show-about;

    // The Amiga tab: 0 a drawer, 1 the WHDLoad package; where it goes; what it is made
    // from (the setup's own copy of the program, or a drawer the player unpacked).
    in-out property <int> amiga-kind: 0;
    in property <string> amiga-dest;
    in property <string> amiga-program;
    in property <bool> amiga-own-program;
    in property <bool> can-make-amiga;
    in property <string> amiga-status;
    in property <bool> amiga-error;
    in property <bool> amiga-done;
    in property <float> amiga-progress;
    // World 2026-27 on the Amiga: offered once its package is installed (or a source), off
    // unless asked for (the Amiga has no SWOS.ini: the drawer plays the world it is made with).
    in property <bool> amiga-world-available;
    in-out property <bool> amiga-world;

    callback choose-folder();
    callback browse-source(int);
    callback source-edited(int, string);
    callback source-committed(int, string);
    callback stop-scan();
    callback clear-sources();
    callback change-out();
    callback install();
    callback play();
    callback open-url(string);
    callback change-amiga-dest();
    callback choose-amiga-program();
    callback make-amiga();
    callback amiga-kind-changed();
    callback open-amiga-dest();

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }


    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        // Details open: its log takes the spare height. Closed: everything at its own
        // height from the top, the rest left empty -- the window stays as tall as opening
        // it made it, and nothing else may grow into that.
        alignment: root.show-details ? LayoutAlignment.stretch : LayoutAlignment.start;

        // What this is.
        HorizontalLayout {
            spacing: 14px;
            Image {
                source: @image-url("../../../../packaging/linux/hicolor/64x64/apps/openswos.png");
                width: 52px;
                height: 52px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "OpenSWOS Setup";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: "OpenSWOS plays with the data of a copy of Sensible World of Soccer you own. Get it from the links below: what you download is found here by itself.";
                    wrap: word-wrap;
                    color: Theme.text-dim;
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    icon: @image-url("icons/info-circle.svg");
                    tooltip: "About";
                    clicked => { root.show-about = true; }
                }
            }
        }

        // Which version.
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Tab {
                label: "PC · Mac · Linux";
                icon: @image-url("images/pc-mac-linux.svg");
                icon-width: 69px;
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            Tab {
                label: "Amiga";
                icon: @image-url("images/amiga-check.svg");
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
        }

        // 1. Get the game.
        Card {
            title: root.tab == 0 ? "1.  Get the game" : "1.  Get the game's data";
            Text {
                text: root.tab == 0
                    ? "You need the PC game or the Amiga version; with both, OpenSWOS plays the Amiga's music and sounds on the PC game's data."
                    : "The Amiga version of OpenSWOS needs both: the Amiga version for the game's own files, the PC game for the AGA pitches and pictures.";
                wrap: word-wrap;
                color: Theme.text-dim;
                font-size: 12px;
            }
            if root.tab == 0: VerticalLayout {
                spacing: 14px;
                for idx in root.rows-pc: SourceLine {
                    item: root.sources[idx];
                    need: root.sources[idx].need-pc;
                    about: root.sources[idx].about-pc;
                    enabled: !root.busy;
                    can-pick: root.can-pick;
                    edited(t) => { root.source-edited(idx, t); }
                    committed(t) => { root.source-committed(idx, t); }
                    browse => { root.browse-source(idx); }
                    open-url(u) => { root.open-url(u); }
                }
            }
            if root.tab == 1: VerticalLayout {
                spacing: 14px;
                for idx in root.rows-amiga: SourceLine {
                    item: root.sources[idx];
                    need: root.sources[idx].need-amiga;
                    about: root.sources[idx].about-amiga;
                    enabled: !root.busy;
                    can-pick: root.can-pick;
                    edited(t) => { root.source-edited(idx, t); }
                    committed(t) => { root.source-committed(idx, t); }
                    browse => { root.browse-source(idx); }
                    open-url(u) => { root.open-url(u); }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            HorizontalLayout {
                spacing: 10px;
                Image {
                    source: @image-url("icons/folder-search.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-dim;
                }
                Text {
                    text: root.scanning ? root.scan-status : root.notice != "" ? root.notice : root.watching;
                    horizontal-stretch: 1;
                    color: root.notice-error && !root.scanning && root.notice != "" ? Theme.danger : Theme.text-dim;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    font-size: 12px;
                }
                if !root.scanning: TextButton {
                    label: "Search a folder…";
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.choose-folder(); }
                }
                if root.scanning: TextButton {
                    label: "Stop";
                    icon: @image-url("icons/player-stop.svg");
                    clicked => { root.stop-scan(); }
                }
                TextButton {
                    label: "Start over";
                    enabled: !root.busy;
                    clicked => { root.clear-sources(); }
                }
            }
        }

        // 2. Make it: the PC tab installs where the game reads its data.
        if root.tab == 0: Card {
            title: "2.  Install";
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Into";
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
                Text {
                    text: root.out-dir;
                    horizontal-stretch: 1;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TextButton {
                    label: "Change…";
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.change-out(); }
                }
            }
            if root.out-note != "": Text {
                text: root.out-note;
                color: Theme.text-dim;
                wrap: word-wrap;
                font-size: 12px;
            }
            HorizontalLayout {
                spacing: 12px;
                TextButton {
                    label: root.busy ? "Installing…" : root.outdated ? "Update" : root.done ? "Install again" : "Install";
                    primary: true;
                    width: 140px;
                    enabled: root.can-install && !root.busy;
                    clicked => { root.install(); }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    ProgressIndicator {
                        progress: root.progress;
                        height: 6px;
                    }
                }
                if root.done && root.can-play: TextButton {
                    label: "Play OpenSWOS";
                    primary: true;
                    width: 150px;
                    clicked => { root.play(); }
                }
            }
            Text {
                text: root.status;
                color: root.status-error ? Theme.danger : root.outdated ? Theme.warn : root.done ? Theme.ok : Theme.text-dim;
                font-weight: root.done ? 700 : 400;
                wrap: word-wrap;
            }
        }

        // 2. Make it: the Amiga tab makes a drawer or a WHDLoad package.
        if root.tab == 1: Card {
            title: "2.  Make it for your Amiga";
            HorizontalLayout {
                spacing: 10px;
                Choice {
                    picture: @image-url("images/amiga-drawer.svg");
                    picture-selected: @image-url("images/amiga-drawer-open.svg");
                    picture-width: 65px;   // its own size: pixel art, kept crisp
                    title: "SWOS drawer";
                    text: "A drawer to copy to your Amiga's hard drive, or to use as a folder in WinUAE or FS-UAE. Double-click SWOS to play.";
                    selected: root.amiga-kind == 0;
                    clicked => { root.amiga-kind = 0; root.amiga-kind-changed(); }
                }
                Choice {
                    picture: @image-url("images/whdload.png");
                    picture-width: 96px;
                    title: "WHDLoad package";
                    text: "OpenSWOSAGA-WHDL.lha, to unpack on an Amiga with WHDLoad installed. No Kickstart image needed.";
                    selected: root.amiga-kind == 1;
                    clicked => { root.amiga-kind = 1; root.amiga-kind-changed(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.amiga-kind == 0 ? "Into" : "Save as";
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
                Text {
                    text: root.amiga-dest;
                    horizontal-stretch: 1;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TextButton {
                    label: "Change…";
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.change-amiga-dest(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.amiga-own-program
                        ? "The program: " + (root.amiga-program != "" ? root.amiga-program : "choose SWOS-Amiga.zip (from the same place as this setup)")
                        : "The program comes with this setup.";
                    horizontal-stretch: 1;
                    color: root.amiga-own-program && root.amiga-program == "" ? Theme.warn : Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                TextButton {
                    label: "Choose…";
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.choose-amiga-program(); }
                }
                Link {
                    text: "WHDLoad ↗";
                    url: "https://whdload.de/";
                    vertical-alignment: center;
                    open(u) => { root.open-url(u); }
                }
            }
            if root.amiga-world-available: CheckBox {
                text: "Play World 2026-27 (its clubs and players) instead of 96/97";
                checked <=> root.amiga-world;
                enabled: !root.busy;
                toggled => { root.amiga-kind-changed(); }
            }
            HorizontalLayout {
                spacing: 12px;
                TextButton {
                    label: root.busy ? "Making…" : root.amiga-kind == 0 ? "Make the drawer" : "Make the package";
                    primary: true;
                    width: 160px;
                    enabled: root.can-make-amiga && !root.busy;
                    clicked => { root.make-amiga(); }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    ProgressIndicator {
                        progress: root.amiga-progress;
                        height: 6px;
                    }
                }
                if root.amiga-done: TextButton {
                    label: "Show it";
                    width: 110px;
                    clicked => { root.open-amiga-dest(); }
                }
            }
            Text {
                text: root.amiga-status;
                color: root.amiga-error ? Theme.danger : root.amiga-done ? Theme.ok : Theme.text-dim;
                font-weight: root.amiga-done ? 700 : 400;
                wrap: word-wrap;
            }
        }

        // What will be made and what happened: out of the way until asked for.
        Card {
            vertical-stretch: root.show-details ? 1 : 0;
            HorizontalLayout {
                spacing: 8px;
                // The chevron is drawn: not every system font has ▸ and ▾.
                Path {
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: root.show-details ? "M 1 3 L 9 3 L 5 8 Z" : "M 3 1 L 8 5 L 3 9 Z";
                    fill: Theme.text;
                }
                Text {
                    text: "Details";
                    color: Theme.text;
                    font-weight: 700;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-details = !root.show-details; }
                    }
                }
                Text {
                    text: "what will be made, and the log";
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.show-details: HorizontalLayout {
                spacing: 16px;
                PlanColumn { steps: root.plan-left; }
                PlanColumn { steps: root.plan-right; }
            }
            if root.show-details: LogView { lines: root.log; }
        }
    }

    // About: who made it, and Slint's "Made with Slint" badge, which its royalty-free
    // licence asks every Slint program to show. Over the window; a click outside or OK
    // closes it.
    if root.show-about: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000090;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: about.preferred-width;
            height: about.preferred-height;
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            TouchArea { }   // a click on the panel is not a click outside it

            about := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 16px;
                    Image {
                        source: @image-url("../../../../packaging/linux/hicolor/64x64/apps/openswos.png");
                        width: 64px;
                        height: 64px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "OpenSWOS Setup " + root.version;
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "by Ben Baker";
                            color: Theme.text-dim;
                        }
                        Link {
                            text: "github.com/benbaker76/OpenSWOS";
                            url: "https://github.com/benbaker76/OpenSWOS";
                            open(u) => { root.open-url(u); }
                        }
                    }
                }
                // Baker76's lettering is drawn for a dark ground.
                Rectangle {
                    background: Theme.chrome;
                    border-radius: 8px;
                    HorizontalLayout {
                        alignment: center;
                        padding: 14px;
                        Image {
                            height: 36px;
                            width: 36px * 1008.38 / 162.4;
                            source: @image-url("images/baker76.svg");
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-url("https://baker76.com"); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Image {
                        height: 56px;
                        width: self.height * 212 / 97;
                        source: @image-url("images/made-with-slint.svg");
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://slint.dev"); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        label: "OK";
                        primary: true;
                        clicked => { root.show-about = false; }
                    }
                }
            }
        }
    }
}
